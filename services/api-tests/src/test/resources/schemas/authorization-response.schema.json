{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mti", "stan", "responseCode", "status", "processingTimeMs"],
  "properties": {
    "mti": { "type": ["string", "null"] },
    "stan": { "type": ["string", "null"], "pattern": "^[0-9]{6}$" },
    "rrn": { "type": ["string", "null"], "pattern": "^[0-9]{12}$" },
    "authCode": { "type": ["string", "null"], "pattern": "^[A-Z0-9]{6}$" },
    "responseCode": { "type": ["string", "null"], "pattern": "^[0-9]{2}$" },
    "status": { "type": ["string", "null"], "enum": ["APPROVED", "DECLINED", null] },
    "declineReason": { "type": ["string", "null"] },
    "processingTimeMs": { "type": ["integer", "null"], "minimum": 0 }
  }
}
