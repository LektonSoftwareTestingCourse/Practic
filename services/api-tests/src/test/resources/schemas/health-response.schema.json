{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["status", "service", "version", "services"],
  "properties": {
    "status": { "type": "string", "enum": ["ok", "degraded", "unavailable"] },
    "service": { "type": "string", "const": "gateway" },
    "version": { "type": "string" },
    "services": {
      "type": "object",
      "required": ["switch", "authorization", "cardManagement", "logger"],
      "properties": {
        "switch": { "type": "string" },
        "authorization": { "type": "string" },
        "cardManagement": { "type": "string" },
        "logger": { "type": "string" }
      }
    }
  }
}
